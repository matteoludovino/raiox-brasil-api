# Copy to .env and adjust. Every variable uses the RAIOX_ prefix.
RAIOX_ENV=dev
RAIOX_LOG_LEVEL=INFO
RAIOX_LOG_JSON=true

# Must be 32+ characters in production (the app refuses to start otherwise).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAIOX_ADMIN_TOKEN=change-me

RAIOX_REDIS_URL=redis://localhost:6379/0

# Inbound rate limit (requests per window, per API key)
RAIOX_RATE_LIMIT_WINDOW_S=60
RAIOX_RATE_LIMIT_FREE=30
RAIOX_RATE_LIMIT_PRO=300
RAIOX_RATE_LIMIT_DEMO=20   # shared by every visitor of the public demo

# Optional public demo key, registered idempotently at startup (plan "demo").
# Generate with: python -c "import secrets; print('rx_live_' + secrets.token_urlsafe(24))"
# RAIOX_DEMO_API_KEY=

# Outbound quota per source (req/min) - honors the public APIs' limits
RAIOX_OUTBOUND_CNPJWS_PER_MIN=3
RAIOX_OUTBOUND_RECEITAWS_PER_MIN=3

# Resilience
RAIOX_UPSTREAM_TIMEOUT_S=4
RAIOX_UPSTREAM_RETRIES=2
RAIOX_AGGREGATE_DEADLINE_S=6
RAIOX_BREAKER_FAILURE_THRESHOLD=5
RAIOX_BREAKER_RESET_TIMEOUT_S=30

# Sources (handy for simulating outages: point one at an invalid URL)
# RAIOX_BRASILAPI_URL=https://brasilapi.com.br/api
